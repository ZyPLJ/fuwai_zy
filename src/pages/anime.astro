---
import Comment from "@components/Comment.astro";
import AnimePanel from "@components/AnimePanel.svelte";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { animeList } from "@/data/anime-list";
---

<MainGridLayout title={i18n(I18nKey.anime)} description="记录我看过的番剧">
	<AnimePanel client:load items={animeList} />
	<div class="mt-4"><Comment /></div>
</MainGridLayout>
